<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#e8a020">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Restaurante">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<title>Login — Restaurante</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,sans-serif;background:#f5f5f0;min-height:100vh;display:flex;align-items:center;justify-content:center}
.card{background:#fff;border-radius:18px;padding:2.5rem 2rem;width:100%;max-width:360px;box-shadow:0 4px 24px rgba(0,0,0,.08)}
.logo{text-align:center;font-size:52px;margin-bottom:.5rem}
h1{text-align:center;font-size:22px;font-weight:700;color:#1a1a1a;margin-bottom:.3rem}
.sub{text-align:center;color:#999;font-size:14px;margin-bottom:2rem}
label{display:block;font-size:13px;font-weight:500;color:#444;margin-bottom:.4rem}
input{width:100%;padding:.75rem 1rem;border:1.5px solid #e0e0e0;border-radius:10px;font-size:15px;outline:none;transition:.2s;margin-bottom:1rem}
input:focus{border-color:#e8a020}
button{width:100%;padding:.85rem;background:#e8a020;color:#fff;border:none;border-radius:10px;font-size:16px;font-weight:700;cursor:pointer;transition:.2s}
button:hover{background:#d4901a}
button:active{transform:scale(.98)}
.erro{background:#fde8e8;color:#c0392b;padding:.7rem 1rem;border-radius:8px;font-size:13px;margin-top:.8rem;display:none}
.config-link{text-align:center;margin-top:1.2rem;font-size:12px;color:#bbb}
.config-link a{color:#e8a020;text-decoration:none}
.pwa-banner{background:#e8f4fd;color:#1a6f9e;padding:.7rem 1rem;border-radius:8px;font-size:12px;margin-bottom:1rem;display:none;align-items:center;gap:.6rem}
.pwa-banner button{width:auto;padding:.3rem .8rem;font-size:12px;background:#e8a020;border-radius:6px}
</style>
</head>
<body>
<div class="card">
  <div id="pwa-banner" class="pwa-banner">
    <span>📲 Instale o app para acesso rápido!</span>
    <button onclick="instalarPWA()">Instalar</button>
  </div>
  <div class="logo">🍽️</div>
  <h1>Restaurante</h1>
  <p class="sub">Entre com seu usuário e senha</p>
  <label>Usuário</label>
  <input type="text" id="nome" placeholder="nome de acesso" autocomplete="username">
  <label>Senha</label>
  <input type="password" id="senha" placeholder="senha" autocomplete="current-password">
  <button onclick="entrar()">Entrar</button>
  <div class="erro" id="erro"></div>
  <div class="config-link"><a href="#" onclick="abrirConfig()">⚙️ Configurar conexão Supabase</a></div>
</div>

<!-- Modal configurar Supabase -->
<div id="modal-cfg" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:99;align-items:center;justify-content:center">
<div style="background:#fff;border-radius:16px;padding:1.5rem;width:90%;max-width:400px">
  <h2 style="font-size:16px;font-weight:700;margin-bottom:1rem">⚙️ Conexão Supabase</h2>
  <label style="display:block;font-size:13px;font-weight:500;margin-bottom:.3rem">URL do Projeto</label>
  <input type="text" id="cfg-url" placeholder="https://xxx.supabase.co" style="width:100%;padding:.65rem .9rem;border:1.5px solid #e0e0e0;border-radius:9px;font-size:13px;outline:none;margin-bottom:.8rem">
  <label style="display:block;font-size:13px;font-weight:500;margin-bottom:.3rem">Anon Key</label>
  <input type="text" id="cfg-key" placeholder="eyJhbGciO..." style="width:100%;padding:.65rem .9rem;border:1.5px solid #e0e0e0;border-radius:9px;font-size:13px;outline:none;margin-bottom:1rem">
  <div style="display:flex;gap:.6rem">
    <button onclick="fecharConfig()" style="flex:1;background:#f0f0f0;color:#666;border:none;border-radius:10px;padding:.7rem;font-size:14px;cursor:pointer">Cancelar</button>
    <button onclick="salvarConfig()" style="flex:1">Salvar</button>
  </div>
</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script src="app.js"></script>
<script>
let deferredPrompt = null;

document.addEventListener('keydown', e => { if (e.key === 'Enter') entrar(); });

window.addEventListener('beforeinstallprompt', e => {
  e.preventDefault();
  deferredPrompt = e;
  document.getElementById('pwa-banner').style.display = 'flex';
});

async function instalarPWA() {
  if (!deferredPrompt) return;
  deferredPrompt.prompt();
  const { outcome } = await deferredPrompt.userChoice;
  if (outcome === 'accepted') document.getElementById('pwa-banner').style.display = 'none';
  deferredPrompt = null;
}

async function entrar() {
  const nome = document.getElementById('nome').value.trim();
  const senha = document.getElementById('senha').value;
  const err = document.getElementById('erro');
  err.style.display = 'none';
  if (!nome || !senha) { err.textContent = 'Preencha usuário e senha'; err.style.display = 'block'; return; }
  try {
    const u = await login(nome, senha);
    salvarSessao(u);
    if (u.perfil === 'cozinha') location.href = 'cozinha.html';
    else location.href = 'painel.html';
  } catch(e) {
    err.textContent = e.message || 'Erro ao conectar';
    err.style.display = 'block';
  }
}

function abrirConfig() {
  document.getElementById('cfg-url').value = localStorage.getItem('sb_url') || '';
  document.getElementById('cfg-key').value = localStorage.getItem('sb_key') || '';
  document.getElementById('modal-cfg').style.display = 'flex';
}

function fecharConfig() { document.getElementById('modal-cfg').style.display = 'none'; }

function salvarConfig() {
  const url = document.getElementById('cfg-url').value.trim();
  const key = document.getElementById('cfg-key').value.trim();
  if (!url || !key) { alert('Preencha os dois campos'); return; }
  localStorage.setItem('sb_url', url);
  localStorage.setItem('sb_key', key);
  fecharConfig();
  location.reload();
}
</script>
</body>
</html>
